# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env

# User-defined LLM providers
custom_providers.yaml

# The working copy of the dataset: it lives on the Hugging Face Hub instead
.dataset/

# What `dataset push --dry-run` would have sent, left there to be read over
.preview/

# Generated explanations. They live in the dataset on the Hugging Face Hub, not
# here. Only the text files are ignored: anything else in a folder, such as the
# list of questions a run was given, is an input and stays in git.
/*_created/*.md
/*_created/*.txt

# Any generated files
**/*.jsonl
**/*.json
!tinyfacts/thing-explainer/word-forms.json
!tinyfacts/thing-explainer/circumlocutions.json
query_logs/

# With exceptions
!tinyfacts/thing-explainer/action-nouns.json

# Models
.fine-tuned-models

